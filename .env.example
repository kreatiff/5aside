# Runtime environment
NODE_ENV=production

# Server port inside the container (keep as 4000)
PORT=4000

# Host port Portainer maps to (change this to avoid conflicts on your server)
APP_PORT=4000

# PostgreSQL connection string
# If your DB is on the same Docker host, use the host's LAN IP (not localhost)
DATABASE_URL=postgresql://user:password@192.168.1.x:5432/5aside

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-32-char-min-random-string
JWT_REFRESH_SECRET=replace-with-32-char-min-random-string

# Shared secret for webhook endpoints (x-webhook-secret header)
WEBHOOK_SHARED_SECRET=replace-with-32-char-min-random-string

# App settings
DEFAULT_GAME_FEE_CENTS=1500
APP_TIMEZONE=Australia/Brisbane
