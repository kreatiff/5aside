{
  "name": "@fiveaside/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run build -w @fiveaside/contracts && npm run build -w @fiveaside/recon && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "npm run build -w @fiveaside/contracts && npm run build -w @fiveaside/recon && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:create": "node-pg-migrate create",
    "db:create-admin": "tsx src/scripts/create-admin.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fiveaside/contracts": "0.1.0",
    "@fiveaside/recon": "0.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.7.4",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
