{
  "name": "fiveaside",
  "version": "0.1.9",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @fiveaside/api",
    "dev:web": "npm run dev -w @fiveaside/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:init": "npm run db:init -w @fiveaside/api",
    "db:migrate": "npm run db:migrate -w @fiveaside/api",
    "db:create-admin": "npm run db:create-admin -w @fiveaside/api",
    "db:seed": "npm run db:seed -w @fiveaside/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
